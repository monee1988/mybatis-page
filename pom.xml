<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.monee1988</groupId>
    <artifactId>mybatis-page</artifactId>
    <version>1.1.1-RELEASE</version>
    <packaging>jar</packaging>

    <name>mybatis-page</name>
    <url>https://github.com/monee1988/mybatis-page</url>
    <description>MyBatis 物理分页插件：兼容 Spring Boot 2.x / 3.x，无 servlet 依赖，修复 count 统计缺陷</description>

    <!--
      自包含 POM：全部元数据与发布插件在本文件内声明，不继承任何 parent，
      可独立构建并 deploy 到 Maven Central。
    -->

    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>greatPwx</id>
            <name>greatPwx</name>
            <email>greatpwx@126.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git@github.com:monee1988/mybatis-page.git</connection>
        <developerConnection>scm:git:git@github.com:monee1988/mybatis-page.git</developerConnection>
        <url>https://github.com/monee1988/mybatis-page</url>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <mybatis.version>3.5.16</mybatis.version>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>

        <!-- mybatis -->
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis</artifactId>
            <version>${mybatis.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
          日志：不引入任何日志依赖，直接使用运行期必存在的 MyBatis 自带
          org.apache.ibatis.logging.LogFactory（自动探测 slf4j / log4j2 / JUL 等）。
        -->

        <!-- 单元测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.0</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- 固定 surefire 版本，保证 JUnit 5 平台被正确识别 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
            </plugin>
        </plugins>
    </build>

    <!--
      快照仓库指向 Central Portal；正式版由 sonatype-oss-release profile 中的
      central-publishing-maven-plugin 上传，不经过 repository 地址。
    -->
    <distributionManagement>
        <snapshotRepository>
            <id>central</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>

    <profiles>
        <profile>
            <id>sonatype-oss-release</id>
            <build>
                <plugins>
                    <!-- Source -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.2.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Javadoc -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.3.2</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <doclint>all,-missing</doclint>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!--
                      GPG 签名。
                      3.x 版本才支持 pinentry-mode 的 loopback 模式：否则在无图形界面的终端里
                      gpg 会尝试弹出 pinentry 对话框，CI 或 SSH 环境下直接挂住。
                      口令通过 -Dgpg.passphrase=xxx 传入（对应插件参数 gpg.passphrase），
                      不写死在 POM 里。若私钥未设口令，可省略该参数。
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </plugin>
                    <!--
                      Central Portal 发布（替代已关停的 OSSRH）。
                      autoPublish=false：上传后到 central.sonatype.com 手动点 Publish，
                      避免误发后不可撤回。
                    -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.10.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
